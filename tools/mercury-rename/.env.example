# Copy to .env and fill in — NEVER commit the filled-in file.
# The key is an Inception Mercury key (get one at
# https://platform.inceptionlabs.ai). It is read from the
# environment only (MERCURY_API_KEY).
MERCURY_API_KEY=
# Defaults are already correct; uncomment to override.
# MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
# MERCURY_MODEL=mercury-3
# MERCURY_REASONING_EFFORT=low
